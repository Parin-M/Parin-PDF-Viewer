class PDFPageLabel(QLabel):
    def __init__(self, viewer_instance):
        super().__init__()
        self.viewer = viewer_instance
        self.setAlignment(Qt.AlignCenter)
        self.current_stroke = []
        self.setMouseTracking(True)

    def mousePressEvent(self, event: QMouseEvent):
        if not self.viewer.doc or not self.viewer.active_tool or event.button() != Qt.LeftButton: 
            return
        
        pdf_pt = self.viewer.get_pdf_coords(event.position())
        page = self.viewer.doc.load_page(self.viewer.current_page)

        if self.viewer.active_tool in ['pen', 'highlight']:
            self.current_stroke = [(pdf_pt.x, pdf_pt.y)]
            self.viewer.is_drawing = True

        elif self.viewer.active_tool == 'eraser':
            self.viewer.erase_at_point(page, pdf_pt)

        elif self.viewer.active_tool == 'text':
            t = TRANSLATIONS[self.viewer.current_lang]
            text, ok = QInputDialog.getText(self, t["add_text"], t["enter_text"])
            if ok and text:
                r, g, b = self.viewer.selected_color.redF(), self.viewer.selected_color.greenF(), self.viewer.selected_color.blueF()
                annot = page.add_freetext_annot(fitz.Rect(pdf_pt.x, pdf_pt.y, pdf_pt.x + 200, pdf_pt.y + 30), text, fontsize=12, text_color=(r, g, b))
                annot.update()
                self.viewer.render_page()

    def mouseMoveEvent(self, event: QMouseEvent):
        if not self.viewer.doc or not self.viewer.active_tool: 
            return
        
        pdf_pt = self.viewer.get_pdf_coords(event.position())
        page = self.viewer.doc.load_page(self.viewer.current_page)

        if self.viewer.active_tool in ['pen', 'highlight'] and self.viewer.is_drawing:
            self.current_stroke.append((pdf_pt.x, pdf_pt.y))

        elif self.viewer.active_tool == 'eraser' and (event.buttons() & Qt.LeftButton):
            self.viewer.erase_at_point(page, pdf_pt)

    def mouseReleaseEvent(self, event: QMouseEvent):
        if self.viewer.is_drawing and len(self.current_stroke) > 1 and self.viewer.doc:
            page = self.viewer.doc.load_page(self.viewer.current_page)
            r, g, b = self.viewer.selected_color.redF(), self.viewer.selected_color.greenF(), self.viewer.selected_color.blueF()

            annot = page.add_ink_annot([self.current_stroke])
            annot.set_colors(stroke=(r, g, b))
            
            if self.viewer.active_tool == 'pen':
                annot.set_border(width=2)
            elif self.viewer.active_tool == 'highlight':
                annot.set_border(width=14)
                annot.set_opacity(0.35)

            annot.update()
            self.viewer.render_page()

        self.viewer.is_drawing = False
        self.current_stroke = []

class ParinPDFViewer(QMainWindow):
    def __init__(self):
        super().__init__()
        self.doc = None
        self.file_path = ""
        self.current_lang = "fa"
        self.current_page = 0
        self.zoom_factor = 1.0
        self.fit_mode = 'width'
        self.active_tool = None
        self.is_drawing = False

        self.selected_color = QColor(103, 80, 164)

        self.player = QMediaPlayer(self)
        self.audio_output = QAudioOutput(self)
        self.player.setAudioOutput(self.audio_output)
        self.player.setSource(QUrl(LOFI_STREAM_URL))
        self.audio_output.setVolume(0.5)
        self.is_lofi_playing = False

        self.setMinimumSize(1150, 750)
        self.init_ui()
        self.setStyleSheet(COLOR_THEMES["ارغوانی (Purple)"])
        self.apply_language(self.current_lang)

    def init_ui(self):
        central_widget = QWidget(self)
        self.setCentralWidget(central_widget)
        self.main_layout = QVBoxLayout(central_widget)
        self.main_layout.setContentsMargins(0, 0, 0, 0)

        self.top_bar = QWidget(self)
        self.top_bar.setObjectName("top_bar")
        self.top_bar.setFixedHeight(60)
        bar_layout = QHBoxLayout(self.top_bar)
        bar_layout.setContentsMargins(10, 5, 10, 5)

        self.btn_open = self.create_btn("", self.open_file)
        self.btn_save = self.create_btn("", self.save_file)
        
        self.btn_pen = self.create_btn("", lambda: self.toggle_tool('pen'), checkable=True)
        self.btn_highlight = self.create_btn("", lambda: self.toggle_tool('highlight'), checkable=True)
        self.btn_eraser = self.create_btn("", lambda: self.toggle_tool('eraser'), checkable=True)
        self.btn_add_text = self.create_btn("", lambda: self.toggle_tool('text'), checkable=True)
        
        self.btn_color = self.create_btn("", self.choose_color)
        self.update_color_btn_style()

        self.btn_theme = self.create_btn("", None)
        theme_menu = QMenu(self)
        for theme_name in COLOR_THEMES.keys():
            action = QAction(theme_name, self)
            action.triggered.connect(lambda ch, t=theme_name: self.setStyleSheet(COLOR_THEMES[t]))
            theme_menu.addAction(action)
        self.btn_theme.setMenu(theme_menu)

        self.btn_zoom_in = self.create_btn("", self.zoom_in)
        self.btn_zoom_out = self.create_btn("", self.zoom_out)
        self.btn_fit_width = self.create_btn("", self.fit_width)
        self.btn_fit_page = self.create_btn("", self.fit_page)

        self.btn_prev = self.create_btn("", self.prev_page)
        self.btn_next = self.create_btn("", self.next_page)
        
        self.lbl_page = QLabel("صفحه:")
        self.spin_page = QSpinBox()
        self.spin_page.setMinimum(1)
        self.spin_page.valueChanged.connect(self.go_to_page)

        self.btn_print_opt = self.create_btn("", self.print_document)
        self.btn_pass_remove = self.create_btn("", self.remove_password)
        self.btn_pass_add = self.create_btn("", self.add_password)
        self.btn_lofi = self.create_btn("", self.toggle_lofi)

        self.btn_lang = self.create_btn("", None)
        lang_menu = QMenu(self)
        for code, name in [("fa", "فارسی"), ("en", "English")]:
            action = QAction(name, self)
            action.triggered.connect(lambda ch, l=code: self.apply_language(l))
            lang_menu.addAction(action)
        self.btn_lang.setMenu(lang_menu)

        widgets = [
            self.btn_open, self.btn_save, self.btn_pen, self.btn_highlight,
            self.btn_eraser, self.btn_add_text, self.btn_color, self.btn_theme,
            self.btn_zoom_in, self.btn_zoom_out, self.btn_fit_width, self.btn_fit_page,
            self.btn_prev, self.lbl_page, self.spin_page, self.btn_next, 
            self.btn_print_opt, self.btn_pass_remove, self.btn_pass_add, self.btn_lofi, self.btn_lang
        ]
        for w in widgets:
            bar_layout.addWidget(w)

        bar_layout.addStretch()
        self.main_layout.addWidget(self.top_bar)

        self.scroll_area = QScrollArea(self)
        self.scroll_area.setWidgetResizable(True)
        self.scroll_area.setAlignment(Qt.AlignCenter)

        self.page_label = PDFPageLabel(self)
        self.scroll_area.setWidget(self.page_label)
        self.main_layout.addWidget(self.scroll_area)

    def create_btn(self, text, slot, checkable=False):
        btn = QPushButton(text, self)
        btn.setCursor(Qt.PointingHandCursor)
        btn.setCheckable(checkable)
        if slot:
            btn.clicked.connect(slot)
        return btn

    def toggle_tool(self, tool_name):
        if self.active_tool == tool_name:
            self.active_tool = None
        else:
            self.active_tool = tool_name
        
        self.btn_pen.setChecked(self.active_tool == 'pen')
        self.btn_highlight.setChecked(self.active_tool == 'highlight')
        self.btn_eraser.setChecked(self.active_tool == 'eraser')
        self.btn_add_text.setChecked(self.active_tool == 'text')

    def choose_color(self):
        color = QColorDialog.getColor(self.selected_color, self, "انتخاب رنگ")
        if color.isValid():
            self.selected_color = color
            self.update_color_btn_style()

    def update_color_btn_style(self):
        hex_color = self.selected_color.name()
        text_color = "#FFFFFF" if self.selected_color.lightness() < 128 else "#000000"
        self.btn_color.setStyleSheet(f"background-color: {hex_color}; color: {text_color}; border-radius: 8px;")

    def open_file(self):
        file_path, _ = QFileDialog.getOpenFileName(self, "انتخاب فایل", "", "سندها (*.pdf)")
        if file_path:
            try:
                if self.doc: 
                    self.doc.close()
                
                doc = fitz.open(file_path)
                t = TRANSLATIONS[self.current_lang]

                if doc.is_encrypted:
                    pwd, ok = QInputDialog.getText(self, "رمز عبور", t["enter_pass"], QLineEdit.Password)
                    if ok and pwd:
                        if not doc.authenticate(pwd):
                            QMessageBox.critical(self, "خطا", "رمز عبور اشتباه است!")
                            return
                    else: 
                        return

                self.doc = doc
                self.file_path = file_path
                self.current_page = 0
                self.zoom_factor = 1.0
                
                self.spin_page.blockSignals(True)
                self.spin_page.setMaximum(len(self.doc))
                self.spin_page.setValue(1)
                self.spin_page.blockSignals(False)
                
                # رندر مستقیم صفحه اول بدون ایجاد فریز یا خطای ابعاد
                self.render_page()
            except Exception as e:
                QMessageBox.critical(self, "خطا", f"خطا در باز کردن فایل: {str(e)}")

    def render_page(self):
        if not self.doc or self.current_page < 0 or self.current_page >= len(self.doc):
            return

        page = self.doc.load_page(self.current_page)
        if self.zoom_factor <= 0:
            self.zoom_factor = 1.0
            
        mat = fitz.Matrix(self.zoom_factor, self.zoom_factor)
        pix = page.get_pixmap(matrix=mat)

        img = QImage(pix.samples, pix.width, pix.height, pix.stride, QImage.Format_RGB888)
        self.page_label.setPixmap(QPixmap.fromImage(img))
        self.page_label.adjustSize()

    def get_pdf_coords(self, pos: QPointF):
        pixmap = self.page_label.pixmap()
        if not pixmap or pixmap.isNull():
            return fitz.Point(pos.x(), pos.y())

        label_size = self.page_label.size()
        pixmap_size = pixmap.size()
        
        offset_x = max(0, (label_size.width() - pixmap_size.width()) / 2.0)
        offset_y = max(0, (label_size.height() - pixmap_size.height()) / 2.0)

        adjusted_x = pos.x() - offset_x
        adjusted_y = pos.y() - offset_y

        mat = fitz.Matrix(self.zoom_factor, self.zoom_factor)
        inv_mat = ~mat
        return fitz.Point(adjusted_x, adjusted_y) * inv_mat

    def resizeEvent(self, event):
        super().resizeEvent(event)
        if self.doc:
            if self.fit_mode == 'width':
                self.fit_width()
            elif self.fit_mode == 'page':
                self.fit_page()

    def fit_width(self):
        if not self.doc: return
        self.fit_mode = 'width'
        page = self.doc.load_page(self.current_page)
        scroll_width = self.scroll_area.viewport().width() - 30
        if page.rect.width() > 0 and scroll_width > 0:
            self.zoom_factor = scroll_width / page.rect.width()
            self.render_page()

    def fit_page(self):
        if not self.doc: return
        self.fit_mode = 'page'
        page = self.doc.load_page(self.current_page)
        scroll_height = self.scroll_area.viewport().height() - 30
        if page.rect.height() > 0 and scroll_height > 0:
            self.zoom_factor = scroll_height / page.rect.height()
            self.render_page()

    def zoom_in(self):
        self.fit_mode = None
        if self.zoom_factor < 5.0:
            self.zoom_factor += 0.25
            self.render_page()

    def zoom_out(self):
        self.fit_mode = None
        if self.zoom_factor > 0.3:
            self.zoom_factor -= 0.25
            self.render_page()

    def prev_page(self):
        if self.doc and self.current_page > 0:
            self.current_page -= 1
            self.spin_page.blockSignals(True)
            self.spin_page.setValue(self.current_page + 1)
            self.spin_page.blockSignals(False)
            self.render_page()

    def next_page(self):
        if self.doc and self.current_page < len(self.doc) - 1:
            self.current_page += 1
            self.spin_page.blockSignals(True)
            self.spin_page.setValue(self.current_page + 1)
            self.spin_page.blockSignals(False)
            self.render_page()

    def go_to_page(self, val):
        if self.doc and 1 <= val <= len(self.doc):
            self.current_page = val - 1
            self.render_page()

    def erase_at_point(self, page, pdf_pt):
        radius = 20 / self.zoom_factor
        erase_rect = fitz.Rect(pdf_pt.x - radius, pdf_pt.y - radius, pdf_pt.x + radius, pdf_pt.y + radius)

        erased = False
        annots_to_delete = []
        for annot in page.annots():
            if annot.rect.intersects(erase_rect):
                annots_to_delete.append(annot)

        for annot in annots_to_delete:
            page.delete_annot(annot)
            erased = True

        if erased:
            self.render_page()

    def wheelEvent(self, event):
        if event.modifiers() == Qt.ControlModifier:
            if event.angleDelta().y() > 0:
                self.zoom_in()
            else:
                self.zoom_out()
        else:
            super().wheelEvent(event)

    def toggle_lofi(self):
        if self.is_lofi_playing:
            self.player.stop()
            self.is_lofi_playing = False
            self.btn_lofi.setText(TRANSLATIONS[self.current_lang]["lofi"])
        else:
            self.player.play()
            self.is_lofi_playing = True
            self.btn_lofi.setText("⏸️ توقف موسیقی")

    def print_document(self):
        if not self.doc: return
        printer = QPrinter(QPrinter.HighResolution)
        print_dialog = QPrintDialog(printer, self)
        
        if print_dialog.exec() == QPrintDialog.Accepted:
            painter = QPainter(printer)
            page = self.doc.load_page(self.current_page)
            
            pix = page.get_pixmap(dpi=300)
            img = QImage(pix.samples, pix.width, pix.height, pix.stride, QImage.Format_RGB888)
            
            rect = painter.viewport()
            scaled_img = img.scaled(rect.size(), Qt.KeepAspectRatio, Qt.SmoothTransformation)
            
            x = (rect.width() - scaled_img.width()) // 2
            y = (rect.height() - scaled_img.height()) // 2
            
            painter.drawImage(x, y, scaled_img)
            painter.end()

    def save_file(self):
        if not self.doc: return
        save_path, _ = QFileDialog.getSaveFileName(self, "ذخیره فایل", self.file_path, "PDF (*.pdf)")
        if save_path:
            self.doc.save(save_path)
            QMessageBox.information(self, "موفقیت", "فایل با موفقیت ذخیره شد.")

    def remove_password(self):
        if not self.doc: return
        save_path, _ = QFileDialog.getSaveFileName(self, "ذخیره بدون رمز", "unlocked.pdf", "PDF (*.pdf)")
        if save_path: 
            self.doc.save(save_path, encryption=fitz.PDF_ENCRYPT_NONE)
            QMessageBox.information(self, "موفقیت", "رمز فایل برداشته شد.")

    def add_password(self):
        if not self.doc: return
        t = TRANSLATIONS[self.current_lang]
        pwd, ok = QInputDialog.getText(self, t["pass_add"], t["set_pass"], QLineEdit.Password)
        if ok and pwd:
            save_path, _ = QFileDialog.getSaveFileName(self, "ذخیره فایل رمزگذاری‌شده", "protected.pdf", "PDF (*.pdf)")
            if save_path:
                self.doc.save(save_path, encryption=fitz.PDF_ENCRYPT_AES_128, user_pw=pwd, owner_pw=pwd)
                QMessageBox.information(self, "موفقیت", "رمز عبور با موفقیت اعمال شد.")

    def apply_language(self, code):
        self.current_lang = code
        t = TRANSLATIONS[code]
        self.setWindowTitle(t["title"])
        self.btn_open.setText(t["open"])
        self.btn_save.setText(t["save"])
        self.btn_pen.setText(t["pen"])
        self.btn_highlight.setText(t["highlight"])
        self.btn_eraser.setText(t["eraser"])
        self.btn_add_text.setText(t["add_text"])
        self.btn_color.setText(t["color"])
        self.btn_theme.setText(t["theme"])
        self.btn_zoom_in.setText(t["zoom_in"])
        self.btn_zoom_out.setText(t["zoom_out"])
        self.btn_fit_width.setText(t["fit_width"])
        self.btn_fit_page.setText(t["fit_page"])
        self.btn_prev.setText(t["prev"])
        self.btn_next.setText(t["next"])
        self.lbl_page.setText(t["page"])
        self.btn_print_opt.setText(t["print_opt"])
        self.btn_pass_remove.setText(t["pass_remove"])
        self.btn_pass_add.setText(t["pass_add"])
        if not self.is_lofi_playing: 
            self.btn_lofi.setText(t["lofi"])
        self.btn_lang.setText(t["lang"])
        QApplication.setLayoutDirection(t["dir"])

if __name__ == "__main__":
    app = QApplication(sys.argv)
    viewer = ParinPDFViewer()
    viewer.show()
    sys.exit(app.exec())
